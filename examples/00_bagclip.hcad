// Bag clip: Carlo, hackerscad's mascot, and the model it starts with
// Carlo is a print-in-place clip for bags of biscuits (the
// little crocodile of the logo), also published on
// Printables by hackerscad's author, ready to print:
// https://www.printables.com/model/345684-bag-clip
// Fold the top of the bag and push it into the wavy
// slot, the teeth hold it. Prints flat. Change the
// teeth, the gap or the size and print your own:
// - change the values in Parameters;
// - edit the code: the view updates as you type;
// - right-click a face or an edge for fillets,
//   holes, pockets...
// More in docs/TUTORIAL.md and in the examples.
module bagclip;

import std.shapes;

@param("Height", min: 5.mm, max: 40.mm)
@preset("small", 10.mm) @preset("large", 20.mm)
immutable height = 15.mm;

@param("Teeth per jaw", min: 1, max: 8)
@preset("small", 2) @preset("large", 5)
immutable teeth = 3;

@param("Tooth radius", min: 1.mm, max: 5.mm)
immutable toothR = 2.5.mm;

@param("Gap for the bag", min: 0.5.mm, max: 6.mm)
immutable gap = 2.9.mm;

@param("Jaw thickness", min: 2.mm, max: 10.mm)
immutable jaw = 5.mm;

@param("Back thickness", min: 2.mm, max: 10.mm)
immutable back = 5.4.mm;

@param("Mouth opening", min: 0.deg, max: 5.deg)
immutable mouth = 1.5.deg;

@param("Keyring eye")
immutable eye = true;

// the outline leans: the clip slides onto the bag
immutable lean = 17.deg;
immutable corner = 2.5.mm;

// the rows of tooth centres, above and below y = 0; the slot
// ends on the leaning line through the origin, the back is behind it
immutable axis = toothR + gap / 2;
immutable top = axis + toothR + jaw;
immutable left = -back;

/// x of a leaning side that crosses y = 0 at x0.
Length leaning(Length x0, Length y) => x0 - y * tan(lean);

/// Centre of the k-th round of the row at height y, tilted down by
/// tilt: pockets (even k) and teeth (odd k) alternate, touching each
/// other; the first pocket touches the leaning end of the slot.
Vec2 row(Length y, Angle tilt, int k) =>
    vec(leaning(0.mm, y), y) + vec(cos(tilt), -sin(tilt)) * (toothR / cos(lean + tilt) + 2 * toothR * k);
/// The upper row is level, the lower one opens the mouth.
Vec2 upper(int k) => row(axis, 0.deg, k);
/// ditto
Vec2 lower(int k) => row(-axis, mouth, k);

// the tip of each jaw leans like the back and touches its last
// tooth: where the tooth faces the tip
immutable facing = vec(cos(lean), sin(lean));
immutable upperTouch = upper(2 * teeth - 1) + facing * toothR;
immutable lowerTouch = lower(2 * teeth - 1) + facing * toothR;
// where the tips cross y = 0 (the step between them is in the slot)
immutable upperTip = upperTouch.x + upperTouch.y * tan(lean);
immutable lowerTip = lowerTouch.x + lowerTouch.y * tan(lean);

// the eye: centred on the top edge, touching the leaning back
immutable eyeR = 5.mm;
immutable eyeAt = vec(leaning(left, top) + eyeR / cos(lean), top);

/// The outline without the slot: a leaning block, its
/// lower side following the jaw, with the eye.
Profile block()
{
    immutable tip = leaning(lowerTip, -top);
    auto corners = [
        vec(leaning(left, -top), -top),
        // the lower side drops with the mouth, from where the lower row starts
        vec(tip, -top - (tip - leaning(0.mm, -axis)) * tan(mouth)),
        vec(lowerTip, 0.mm),
        vec(upperTip, 0.mm),
        vec(leaning(upperTip, top), top),
    ];
    // with the eye, the outline goes along the top to the eye's
    // centre, then to where the eye touches the back
    auto p = eye
        ? polygon(corners ~ [eyeAt, eyeAt - facing * eyeR]) + circle(r: eyeR).move(eyeAt)
        : polygon(corners ~ vec(leaning(left, top), top));
    // round the inner corners (grow, shrink back), then the outer
    // ones (shrink, grow back)
    return p
        .offset(1.5.mm).offset(-1.5.mm)
        .offset(-corner).offset(corner);
}

/// A round tooth (or pocket) centred at c.
Profile tooth(Vec2 c) => circle(r: toothR).move(c);

/// The slot: a band between the two rows of tooth centres,
/// the pockets of each jaw added, the teeth taken away.
Profile slot()
{
    // between the rows of tooth centres, from the points where
    // the first pockets touch the end of the slot to those where
    // the tips touch the last teeth: everything meets smoothly
    immutable far = max(upperTip, lowerTip) + 8 * toothR;
    auto s = polygon([
        lower(0) - facing * toothR,
        lower(0),
        lower(2 * teeth - 1),
        lowerTouch,
        vec(far, lowerTouch.y),
        vec(far, upperTouch.y),
        upperTouch,
        upper(2 * teeth - 1),
        upper(0),
        upper(0) - facing * toothR,
    ]);
    foreach (k; 0 .. 2 * teeth)
    {
        auto rounds = tooth(upper(k)) + tooth(lower(k));
        if (k % 2 == 0)
            s += rounds;    // pockets
        else
            s -= rounds;    // teeth
    }
    return s;
}

@part
Solid clip()
{
    auto p = block() - slot();
    if (eye)
        p -= circle(d: 3.8.mm).move(eyeAt);
    return p.extrude(height);
}
