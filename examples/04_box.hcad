// Box with lid: parametric, the first example in the D-like style
module box;

import std.shapes;
import hardware : M3, Screw;

// Each parameter lists its own presets: @preset("name", value).
@param("Outer width", min: 20.mm, max: 200.mm)
@preset("small", 40.mm) @preset("large", 120.mm)
immutable width = 60.mm;

@param("Outer depth", min: 20.mm, max: 200.mm)
@preset("small", 30.mm)
immutable depth = 40.mm;

@param("Height", min: 10.mm, max: 100.mm)
@preset("large", 40.mm)
immutable height = 25.mm;

@param("Wall thickness", min: 1.2.mm, max: 4.mm)
immutable wall = 2.mm;

@param("Corner radius", min: 3.mm, max: 15.mm)
@preset("small", 4.mm)
immutable radius = 6.mm;

// screws: posts in the corners; lip: a rim under the lid fits inside the
// box; flush: the lid sits in a step cut in the rim, level with it
@param("Closure", choices: ["screws", "lip", "flush"])
immutable closure = "screws";

// the gap between lid and box, for printed parts
immutable fit = 0.2.mm;
immutable lipHeight = 4.mm;

/// The outside of the box: its vertical edges rounded.
Solid outside() => box(width, depth, height)
    .fillet(edges.filter(e => e.isParallel(Z)), r: radius);

/// How far each screw's axis is from the outside faces: as near the corner
/// as it can be, with 1.2 mm of wall outside its hole (across the rounded
/// corner too) and its head on the lid. On thick walls it is inside them.
Length screwInset(Screw screw = M3)
{
    immutable keep = max(screw.tap / 2 + 1.2.mm, screw.head / 2 + 0.5.mm);
    // across the corner, the round edge is nearer than the faces
    immutable corner = keep > radius ? radius : radius - (radius - keep) / sqrt(2.0);
    return max(keep, corner);
}

/// Post for a self-tapping screw in the corner towards sx, sy (each -1 or
/// 1), up to the rim: the cylinder and the corner behind it, trimmed by the
/// outside, so that it is one piece with the walls.
Solid post(int sx, int sy, Screw screw = M3)
{
    immutable dx = width / 2 - screwInset(screw), dy = depth / 2 - screwInset(screw);
    auto round = cylinder(d: screw.d * 2.2, h: height)
        .move(x: sx * dx, y: sy * dy);
    auto corner = box(width / 2 - dx, depth / 2 - dy, height)
        .move(x: sx * (dx + width / 2) / 2, y: sy * (dy + depth / 2) / 2);
    return (round + corner) & outside;
}

@part("steelblue")
Solid body()
{
    auto s = outside.shell(open: faces.top, thickness: wall);
    if (closure == "screws")
    {
        immutable dx = width / 2 - screwInset, dy = depth / 2 - screwInset;
        foreach (sx; [-1, 1])
            foreach (sy; [-1, 1])
            {
                s += post(sx, sy);
                // the pilot hole, from the rim down to the floor
                s -= cylinder(d: M3.tap, h: height - wall + 1.mm)
                    .move(x: sx * dx, y: sy * dy, z: wall);
            }
    }
    else if (closure == "flush")
    {
        // the step: half the wall, as deep as the lid is thick
        s -= box(width - wall, depth - wall, wall + 1.mm)
            .fillet(edges.parallel(Z), r: radius - wall / 2)
            .move(z: height - wall);
    }
    return s;
}

/// A rounded plate, `inset` in from the box's outline all round.
Solid plate(Length inset, Length h) => box(width - 2 * inset, depth - 2 * inset, h)
    .fillet(edges.parallel(Z), r: max(radius - inset, 0.5.mm));

/// The lid as it is printed, at the origin.
Solid lidShape()
{
    Solid c;
    switch (closure)
    {
    case "flush":
        // inside the step, with the gap all round
        c = plate(wall / 2 + fit, wall);
        break;
    case "lip":
        // printed upside down: the rim stands on the plate
        auto rim = plate(wall + fit, lipHeight) - plate(2 * wall + fit, 3 * lipHeight).move(z: -lipHeight);
        c = plate(0.mm, wall)
            .chamfer(edges.filter(e => e.mid.z < wall / 2), d: 0.6.mm)
            + rim.move(z: wall);
        break;
    default:
        c = plate(0.mm, wall)
            .chamfer(edges.filter(e => e.mid.z > wall / 2), d: 0.6.mm);   // the whole top edge
        immutable dx = width / 2 - screwInset, dy = depth / 2 - screwInset;
        foreach (sx; [-1, 1])
            foreach (sy; [-1, 1])
                c -= cylinder(d: M3.clearance, h: 3 * wall, center: true).move(x: sx * dx, y: sy * dy);
    }
    return c;
}

/// The lid where it closes the box.
Solid closedLid()
{
    if (closure == "flush")
        return lidShape.move(z: height - wall);
    if (closure == "lip")
        return lidShape.rotate(x: 180).move(z: height + wall);
    return lidShape.move(z: height);
}

@part("orange")
Solid lid() => lidShape.nextTo(body, X, gap: 10.mm);

unittest
{
    assert(body.bbox.size.z <= 40.mm, "must fit in the drawer");
    assert((body & closedLid).isEmpty, "the lid must close without running into the box");
    writeln("body volume: $(format("%.1f", body.volume / 1.cm ^^ 3)) cm³");
}
