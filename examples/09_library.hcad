// Library tour: the built-in hardware, gears, printable mechanisms, joints and molds
// A tour of the built-in libraries, one row each: hardware,
// gears, printable mechanisms, joints, flex and molds. Under
// every object, its name
// (a reference part: drawn, never exported).
module library_tour;

import std.shapes;
import hardware;
import gears;
import hinges : hinge, livingHinge;
import snaps;
import enclosures;
import joints;
import flex;
import molds;

// the grid: columns along X, rows along -Y
immutable col = 55.mm;
immutable row = 75.mm;

/// Moves a solid to its cell of the grid.
Solid cell(Solid s, int c, int r) => s.move(x: c * col, y: -r * row);

// ---- row 0: hardware

@part("silver")
Solid bolt() => cell(screw(M8, 25.mm, threaded: true).move(z: 25.mm), 0, 0);

@part("silver")
Solid m8nut() => cell(nut(M8, threaded: true), 1, 0);

@part("silver")
Solid m8washer() => cell(washer(M8), 2, 0);

// a block with the holes of the library, cut side by side
@part("steelblue")
Solid holes()
{
    auto b = box(50.mm, 20.mm, 10.mm);
    immutable kinds = ["clearance", "tap", "insert", "ribs", "counterbore", "countersink"];
    foreach (i, k; kinds)
        b -= hole(M3, 10.mm, k).move(x: (i - 2.5) * 8.mm, z: 10.mm);
    return cell(b, 3, 0);
}

// ---- row 1: gears (the second one meshes with the first)

@part("orange")
Solid gear1() => cell(spurGear(2.mm, 20, 6.mm, bore: 5.mm), 0, 1);

@part("gold")
Solid gear2() =>
    cell(spurGear(2.mm, 12, 6.mm, bore: 5.mm)
        .rotate(z: 180.deg / 12)
        .move(x: centerDistance(2.mm, 20, 12)), 0, 1);

@part("tomato")
Solid toothed() => cell(rack(2.mm, 8, 6.mm).move(x: -25.mm, y: -10.mm), 2, 1);

// ---- row 2: printable mechanisms

@part("steelblue")
Solid leafA() => cell(hinge().fixed, 0, 2);

@part("skyblue")
Solid leafB() => cell(hinge().moving, 0, 2);

@part("plum")
Solid hook() => cell(snapHook(), 1, 2);

@part("seagreen")
Solid box1() => cell(enclosure(vec(40.mm, 30.mm, 20.mm)).base, 2, 2);

@part("lightgreen")
Solid lid1() => cell(enclosure(vec(40.mm, 30.mm, 20.mm)).lid, 3, 2);

// ---- row 3: joints, flex and molds

// a bar cut in two where a dovetail locks the pieces, drawn apart
immutable dovetail = splitJoint(box(40.mm, 12.mm, 12.mm),
    plane(origin: vec(0.mm, 0.mm, 0.mm), normal: X), kind: "dovetail");

@part("peru")
Solid pieceA() => cell(dovetail.a.move(x: -3.mm), 0, 3);

@part("burlywood")
Solid pieceB() => cell(dovetail.b.move(x: 3.mm), 0, 3);

// a strip that bends in its middle, through rows of slots
@part("mediumpurple")
Solid strip() => cell(kerf(box(45.mm, 20.mm, 2.mm), box(20.mm, 30.mm, 10.mm)), 1, 3);

@part("orchid")
Solid living() => cell(livingHinge(), 2, 3);

// the two halves of a mold round a ball, laid for printing
immutable ballMold = mold(sphere(d: 16.mm),
    plane(origin: vec(0.mm, 0.mm, 0.mm), normal: Z), keys: 3);

@part("khaki")
Solid moldA() => cell(ballMold.aPrint, 3, 3);

@part("darkkhaki")
Solid moldB() => cell(ballMold.bPrint, 4, 3);

// ---- the names, under each column

/// A name lying on the floor, under cell (c, r).
Solid name(string s, int c, int r) =>
    cell(text(s, size: 6.mm).centered.extrude(0.4.mm).move(y: -30.mm), c, r);

@part("dimgray", export: false)
Solid labels() => fuse([
    name("screw", 0, 0), name("nut", 1, 0), name("washer", 2, 0), name("hole kinds", 3, 0),
    name("spurGear", 0, 1), name("rack", 2, 1),
    name("hinge", 0, 2), name("snapHook", 1, 2), name("enclosure", 2, 2), name("lid", 3, 2),
    name("splitJoint", 0, 3), name("kerf", 1, 3), name("livingHinge", 2, 3), name("mold", 3, 3), name("its other half", 4, 3),
]);
