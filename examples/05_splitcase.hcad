// Split case: a case cut in two halves, with pins that align them
// A small case cut in two halves, with pins that keep them
// aligned: split() cuts a solid with a plane, frame() gives a
// coordinate system on a face to build on. The pins stand on
// posts in the inner corners, easy to print.
module splitcase;

import std.shapes;

@param("Length", min: 30.mm, max: 150.mm)
immutable length = 70.mm;

@param("Width", min: 20.mm, max: 100.mm)
immutable width = 40.mm;

@param("Height", min: 10.mm, max: 60.mm)
immutable height = 24.mm;

@param("Wall", min: 2.mm, max: 6.mm)
immutable wall = 3.mm;

@param("Pin clearance", min: 0.mm, max: 0.5.mm)
immutable clearance = 0.2.mm;

immutable pinD = 2.5.mm;
immutable pinH = 3.mm;
immutable postD = 7.mm;

// the posts' centres, in the inner corners
immutable px = length / 2 - wall - postD / 2 + 1.mm;
immutable py = width / 2 - wall - postD / 2 + 1.mm;
immutable corners = [vec(-px, -py), vec(px, -py), vec(px, py), vec(-px, py)];

/// The closed case: a rounded block, hollow inside.
Solid closed()
{
    // rounded corners, and 45° chamfers on the edges that lie on
    // the print bed (the base prints on its bottom, the lid on its top)
    auto outside = box(length, width, height)
        .fillet(edges.parallel(Z), r: 6.mm)
        .chamfer(edges.perpendicular(Z), d: 1.5.mm);
    auto inside = box(length - 2 * wall, width - 2 * wall, height - 2 * wall)
        .fillet(edges.parallel(Z), r: 6.mm - wall)
        .move(z: wall);
    auto c = outside - inside;
    // a post in each inner corner, from the floor to the ceiling
    foreach (p; corners)
        c += cylinder(d: postD, h: height - 2 * wall).move(x: p.x, y: p.y, z: wall);
    return c;
}

// cut halfway up: .below and .above are the two halves
immutable halves = closed().split(plane(origin: vec(0.mm, 0.mm, height / 2), normal: Z));

@part
Solid base()
{
    // the frame of the cut face: origin at its centre, Z pointing up
    auto f = halves.below.frame(faces.top);
    auto b = halves.below;
    // the pins, chamfered at the tip so they find their holes
    auto pin = cylinder(d: pinD, h: pinH)
        .chamfer(edges.of(faces.top), d: 0.6.mm);
    foreach (p; corners)
        b += pin.placeOn(f.at(x: p.x, y: p.y));
    return b;
}

@part("#F2BE94")
Solid lid()
{
    // the same spots on the lid's cut face (its normal points down)
    auto f = halves.above.frame(faces.bottom);
    auto l = halves.above;
    immutable d = pinD + 2 * clearance;
    // (its frame's Y points the other way: the lid is seen from below)
    foreach (p; corners)
        l -= cylinder(d: d, h: pinH + 0.5.mm)
            .move(z: -pinH - 0.5.mm)
            .placeOn(f.at(x: p.x, y: -p.y));
    // turned over and laid next to the base, to show the holes
    return l
        .rotate(x: 180.deg)
        .nextTo(base, Y, gap: 10.mm)
        .align(base, z: "min");
}
