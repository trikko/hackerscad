// The plant pot of docs/TUTORIAL.md, step 2: parameters.
module pot;

import std.shapes;

@param("Bottom diameter", min: 40.mm, max: 200.mm)
immutable bottom = 80.mm;

@param("Top diameter", min: 40.mm, max: 250.mm)
immutable top = 110.mm;

@param("Height", min: 30.mm, max: 250.mm)
immutable height = 90.mm;

@part
Solid pot()
{
    auto side = polygon([
        vec(0.mm, 0.mm),
        vec(bottom / 2, 0.mm),
        vec(top / 2, height),
        vec(0.mm, height),
    ]);
    return side
        .revolve();
}
