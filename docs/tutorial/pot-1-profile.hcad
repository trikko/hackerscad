// The picture of step 1 in docs/TUTORIAL.md: the profile, the axis it turns
// around, and the pot it becomes, see-through.
module profile;

import std.shapes;

/// Half of the pot's side, drawn on XY: x is the radius, y the height.
Profile side()
{
    return polygon([
        vec(0.mm, 0.mm),
        vec(40.mm, 0.mm),
        vec(55.mm, 90.mm),
        vec(0.mm, 90.mm),
    ]);
}

// the profile, stood up where it turns: a thin plate
@part("#c96f4a")
Solid profile()
{
    return side()
        .extrude(1.mm, symmetric: true)
        .rotate(x: 90.deg);
}

// the axis it turns around
@part("dimgray")
Solid axis() => cylinder(d: 1.5.mm, h: 120.mm).move(z: -15.mm);

// what the turn makes, see-through
@part("#8fcbb4", alpha: 0.3, export: false)
Solid pot()
{
    return side()
        .revolve();
}
