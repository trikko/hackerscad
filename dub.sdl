name "hackerscad"
description "Parametric CAD with a small functional language"
authors "Andrea Fontana"
copyright "Copyright © 2026, Andrea Fontana"
license "GPL-3.0-only WITH LicenseRef-hackerscad-model-exception"

targetType "executable"
targetName "hcad"
targetPath "bin"
sourcePaths "source/hackerscad/cli"
importPaths "source"
dependency "hackerscad:core" version="*"
dependency "djson" version="~>0.9.6"

subPackage {
	name "gui"
	targetType "executable"
	targetName "hackerscad"
	targetPath "bin"
	sourcePaths "source/hackerscad/gui"
	importPaths "source"
	dependency "hackerscad:core" version="*"
	dependency "djson" version="~>0.9.6"
	dependency "gid:gtk4" version="~>0.9.11"
	dependency "gid:gtksource5" version="~>0.9.11"
	dependency "gid:adw1" version="~>0.9.11"
	dependency "bindbc-opengl" version="~>1.0.5"
	versions "GL_33"
	stringImportPaths "examples" "docs" "build/gen"
	// Windows: the logo as the executable's icon
	preBuildCommands "sh \"$PACKAGE_DIR/tools/win-resources.sh\"" platform="windows"
	lflags "$PACKAGE_DIR/build/win/native/hackerscad.res" platform="windows"
	// a windowed program: no console window opens with it
	lflags "/SUBSYSTEM:WINDOWS" "/ENTRY:wmainCRTStartup" platform="windows"
}

subPackage {
	name "core"
	targetType "library"
	targetPath "build/lib"
	sourcePaths "source/hackerscad"
	importPaths "source"
	excludedSourceFiles "source/hackerscad/cli/*" "source/hackerscad/gui/*"
	dependency "djson" version="~>0.9.6"
	stringImportPaths "docs" "examples" "lib" "build/gen"
	// the list of the Examples menu, from the files in examples/
	preBuildCommands "sh \"$PACKAGE_DIR/tools/examples-list.sh\""
	// the version shown: a release's number, or the commit and its date
	preBuildCommands "sh \"$PACKAGE_DIR/tools/version.sh\""
	extraDependencyFiles "source/hackerscad/kernel/occt/shim.cpp" "source/hackerscad/kernel/occt/shim.h" "tools/build-native.sh"
	// Linux and macOS: the OpenCascade shim linked statically
	preBuildCommands "$PACKAGE_DIR/tools/build-native.sh" platform="posix"
	lflags "$PACKAGE_DIR/build/native/libhcad_occt.a" platform="posix"
	libs "TKernel" "TKMath" "TKG2d" "TKG3d" "TKGeomBase" "TKGeomAlgo" "TKBRep" "TKTopAlgo" \
		"TKPrim" "TKBO" "TKBool" "TKFillet" "TKOffset" "TKFeat" "TKShHealing" "TKMesh" "TKV3d" "TKService" \
		"TKXSBase" "TKDE" "TKDESTEP" "TKHLR" platform="posix"
	// the C++ runtime differs per system
	libs "stdc++" platform="linux"
	libs "c++" platform="osx"
	lflags "-L/opt/homebrew/lib" "-L/usr/local/lib" platform="osx"
	// Windows: the shim behind its C interface in hcad_native.dll (built with
	// clang/libc++ against MSYS2's CLANG64 libraries, natively or from Linux)
	preBuildCommands "sh \"$PACKAGE_DIR/tools/build-native.sh\" windows" platform="windows"
	lflags "$PACKAGE_DIR/build/win/native/hcad_native.lib" platform="windows"
}
